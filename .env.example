SUPABASE_URL=
SUPABASE_SERVICE_KEY=
GROQ_API_KEY=
SEMANTIC_SCHOLAR_API_KEY=
TAVILY_API_KEYS=tavily_key1,tavily_key2,tavily_key3
EXA_API_KEYS=exa_key1,exa_key2,exa_key3
PARALLEL_API_KEYS=parallel_key1,parallel_key2,parallel_key3
IEEE_API_KEY=ieee_key1
DOCLING_URL=http://localhost:5001
PDFFIGURES_URL=http://localhost:5002
UNPAYWALL_EMAIL=<your-email-address>
# Semantic Scholar retry/backoff (optional; defaults shown)
S2_MAX_ATTEMPTS=1
S2_BACKOFF_BASE_SECONDS=5
S2_BACKOFF_CAP_SECONDS=60

# OpenAlex (optional; the source is skipped when no key is set)
# comma-separated for rotation (OPENALEX_API_KEY also accepted for a single key)
OPENALEX_API_KEYS=
OPENALEX_MAX_ATTEMPTS=4
OPENALEX_BACKOFF_BASE_SECONDS=2
OPENALEX_BACKOFF_CAP_SECONDS=30
OPENALEX_TIMEOUT_SECONDS=90
OPENALEX_RERANK=true      # AI-reranked keyword search (~20 credits/search)
OPENALEX_SEMANTIC=true    # semantic search (~10 credits/search)

# Hugging Face (only for evaluation/relevance_judge/upload_to_huggingface.py; needs a WRITE token)
HF_TOKEN=
# optional, e.g. your-username/trace-relevance-judge (leave empty for the default)
HF_DATASET_REPO=

# --- TRACE model server (vLLM + FastAPI wrapper over Tailscale): planner (/decompose) and judge (/judge) ---
# server address (default https://mllab.tail0f44aa.ts.net) and the API key (the name x-api-key also works)
TRACE_LLM_URL=
TRACE_LLM_API_KEY=
TRACE_LLM_TIMEOUT_SECONDS=240
# groq = fall back to Groq when the server is unreachable, none = raise / keep papers without a judgment
TRACE_LLM_FALLBACK=groq
# the relevance judge runs only when this is true; JUDGE_BACKEND is server or groq
USE_LLM_JUDGMENT=true
JUDGE_BACKEND=server
JUDGE_WORKERS=8
# Sub-questions whose relevance filter runs at the same time (the embedding encode is serialised, the judge waits overlap); 1 = one after the other
# RELEVANCE_WORKERS=2   (each worker uses JUDGE_WORKERS judge threads, so 2 x 8 = 16 requests to the host at once; 4 would be 32, not tested)
GROQ_JUDGE_MODEL=openai/gpt-oss-120b
# planner limits: sub-questions kept and search queries per sub-question
MAX_SUBQUESTIONS=5
MAX_QUERIES_PER_SUBQUESTION=3
# parsing: papers parsed per sub-question (best combined_score first; 0 = parse all kept papers)
PARSE_TOP_N_PER_SUBQUESTION=5
# a sub-question may try up to this many times N papers to get N with usable full text
PARSE_MAX_ATTEMPTS_FACTOR=2
# PDFs larger than this many MB are skipped (0 = no cap)
MAX_PDF_SIZE_MB=20
# OpenAlex requests allowed in flight at once (across all sub-questions); lower it if you still see HTTP 429
OPENALEX_MAX_CONCURRENT=2
#Scopus API KEY
SCOPUS_API_KEY=
# parse cache: reuse a stored parse of the same paper (arXiv id / DOI / title) from any earlier query (needs migration 009)
PARSE_CACHE=true
# Docling: OCR is off by default (born-digital PDFs; 2.2x faster, same text); a nearly empty result is retried with OCR.
# DOCLING_DO_OCR=true always OCRs. DOCLING_TIMEOUT_SECONDS is the per-request timeout.
DOCLING_DO_OCR=false
DOCLING_TIMEOUT_SECONDS=300
# planner: sub-questions whose topics are at least this similar (bge cosine) are merged; 1.0 turns merging off
# exact (default): merge only sub-questions with the same content words. embedding: merge when bge cosine >= SUBQUESTION_MERGE_SIMILARITY
# (the old rule; it merged different questions: memory cost into performance, long-sequence performance into training efficiency). off: never.
SUBQUESTION_MERGE=exact
SUBQUESTION_MERGE_SIMILARITY=0.97
# detail questions kept on a sub-question after a merge
MAX_DETAIL_QUESTIONS=5
# Groq: several keys (comma-separated) are used round-robin and a rate-limited key is parked for Groq's Retry-After.
# NOTE: Groq limits are per ORGANIZATION, so extra keys only add capacity if they belong to different Groq accounts.
# GROQ_API_KEYS=gsk_key1,gsk_key2
# Stage 3 digest calls in flight (default: one per Groq key)
# STAGE3_WORKERS=2
# Sub-questions whose Stage 3 preparation (aspect split via Groq, chunking, embeddings) runs at the same time; 1 = one after the other
# STAGE3_PREP_WORKERS=4
# A key limited for longer than this many seconds counts as exhausted (e.g. a daily limit) and the call fails fast
GROQ_MAX_WAIT_SECONDS=120
# Scopus (searched through the host, which is on the entitled campus network; the SCOPUS_API_KEY lives in the HOST's .env,
# not here). Set SCOPUS_ENABLED=false to skip it. One page of results per query (max 25).
SCOPUS_ENABLED=true
SCOPUS_RESULTS_PER_QUERY=25
SCOPUS_MAX_CONCURRENT=3
# SCOPUS_MIN_YEAR=2020
# parse papers that have an arXiv id or a PDF link before DOI-only papers (Scopus results are DOI-only)
PARSE_PREFER_DIRECT_PDF=true
# Semantic Scholar SEARCH circuit breaker: auto = one probe request, skip Semantic Scholar search for the rest of the run if it
# fails (429 / 5xx / network) or gives up S2_TRIP_AFTER searches in a row; off = never search; on = always search (no breaker).
# Citation enrichment is not affected.
S2_SEARCH=auto
S2_TRIP_AFTER=3
#Maximum Papers and Web Searches for the stage 3 digest
MAX_PAPERS=5
MAX_WEB_SEARCHES=3
# PDF failure memory: a paper whose PDF failed for a lasting reason (HTTP 403/404/410/451, an HTML landing page, over the size cap)
# is skipped for this many days instead of repeating the whole download chain every run; 0 = off. Needs migration 011
# (without it failures are remembered for the current run only).
PDF_FAILURE_TTL_DAYS=7

# ---- PDF download routes (docs/reports/06_pdf_access_plan.md). true = on, false = off. ----
# Order: the paper's own links -> Unpaywall -> OpenAlex content API -> OSF/Zenodo APIs -> arXiv preprint -> headless browser -> HTML full text
OPENALEX_CONTENT=true          # OpenAlex's cached open-access PDFs (uses OPENALEX_API_KEYS, rotates keys on 402/403/429)
REPOSITORY_APIS=true           # OSF and Zenodo official file APIs
ARXIV_TITLE_TWIN=true          # the same paper on arXiv, near-exact title match only
HTML_FULLTEXT=true             # last resort: an HTML page that holds the whole article, read by Docling
HTML_FULLTEXT_MIN_CHARS=15000  # an abstract page is 5,000 to 8,000 characters, a full article 30,000+
PLAYWRIGHT_FALLBACK=true       # the headless-browser last resort (undetected_playwright). It never succeeded in the logs and costs up to
                               # 30 s per paper; set false to switch it off (recommended by report 6)
DOCLING_FETCH_FIRST=false      # true: the Docling host downloads public PDF URLs itself (about 6.5 s per paper faster, no figures)
# polite access
HONEST_USER_AGENT=true         # identify the pipeline with a contact address instead of posing as Chrome (downloads work the same)
POLITE_HOST_INTERVAL_SECONDS=2.0   # minimum gap between requests to one host; 0 = off
RESPECT_ROBOTS_TXT=true        # robots.txt is honoured for landing pages whose PDF link we follow
RETRY_403_WITHOUT_QUERY=false  # true: after an HTTP 403 retry the URL without its query string
ROUTE_TIMEOUT_SECONDS=90       # one fallback route may hold a parse slot at most this long
USE_JUDGE_COVERAGE=true
# --- Stage 3 digest reproducibility ---
# Cache of the digest model's reply per (sub-question, source, aspects, model, prompt, sampling, chunk text). Re-running Stage 3 on the
# same sources then gives identical findings. Set false to always call the model again.
DIGEST_CACHE=true
DIGEST_CACHE_DIR=.cache/digests
# Sampling of the digest call. Defaults = old behaviour. temperature 0 + a seed does NOT make reruns identical on Groq (measured), use the cache.
DIGEST_TEMPERATURE=0.1
DIGEST_SEED=

# --- Stage 3 coverage: one finding counts for one aspect (experiment, default off) ---
# true = a finding that the judge rated "yes" for several aspects counts only for the aspect it is most similar to.
ONE_FINDING_ONE_ASPECT=false
# With a margin > 0 a "yes" is dropped only if another aspect is at least this much more similar (near-ties are kept). 0 = strict best-aspect only.
ONE_FINDING_MARGIN=0
# Judge cache key includes this id; change it when the judge prompt on the host changes (e.g. judge-v2) so old verdicts are not reused.
JUDGE_MODEL_ID=judge-v2
# The evidence judge reuses TRACE_LLM_URL and TRACE_LLM_API_KEY (same model server). JUDGE_URL / JUDGE_API_KEY exist only as optional overrides.
# JUDGE_PARALLEL=2             Stage 3 judge batches sent to the model server at the same time (default 2; 1 = one after the other, as before).
#                              Measured on the host (8-item batches): 2 at once took 8.0 s vs 8.6 + 9.4 s one by one, 3 at once 11.9 s; same verdicts. See docs/reports/21_timings.md

# --- Stage 3 aspect de-duplication ---
# exact (default): merge only identical aspects of the SAME detail question.
# embedding: the old rule (merge aspects with cosine >= NEAR_DUP_ASPECT_SIM). It merged unrelated aspects (defined/measured, sources/impacts,
#            empirical/theoretical) and could drop a whole detail question from coverage. Only for rebuilding runs made before 2026-11-05.
# off: never merge.
ASPECT_MERGE=exact

# --- Stage 1 domain anchor ---
# true: one LLM call per question derives a field phrase (e.g. "deep learning") that is added to every search query and to the
# embedding pre-filter text, plus a one-sentence field description that the relevance judge sees. Fixes ambiguous terms such as
# "transformers" (electrical vs neural network) and "state space models" (statistical vs deep learning). Cached per question.
DOMAIN_ANCHOR=true

# --- Planner plan cache ---
# true: the plan from /decompose is stored per question and reused on the next run, so reruns start from the same sub-questions and
# queries. The planner (LoRA on vLLM) is not reproducible even at temperature 0 and with a seed (docs/reports/13_planner_determinism.md).
# true (default since 2026-11-13): a question planned before reuses its stored plan; false: every run plans freshly. A Groq-fallback plan is never stored. Change PLAN_CACHE_TAG, or delete the file, to plan again.
PLAN_CACHE=true
# Sub-questions a good answer needs that the fine-tuned planner does not write (answer_needs.py, 2026-11-13): up to this many (0 = off, max 3) are added: when the
# approach fails and by how much, and the risks and defences (or the reported figures), with search queries aimed at primary studies, benchmarks and meta-analyses.
# Within MAX_SUBQUESTIONS the definitional "What is X?" sub-questions that share the fewest words with the question are left out to make room. One Groq call (~700 tokens),
# stored in the plan cache, so a rerun of the question plans the same way.
PLAN_ANSWER_SUBQUESTIONS=2
# PLAN_CACHE_DIR=.cache/plans
# PLAN_CACHE_TAG=

# Stage 3 preparation: embeddings of a paper's chunks are stored on disk and reused by later sub-questions and later runs (identical selection).
# CHUNK_EMBED_CACHE=true
# CHUNK_EMBED_CACHE_DIR=.cache/chunk_embeddings

# --- Loop 2 query step (apps/api/agents/stage1_planner/gap_queries.py; not wired into the pipeline yet) ---
# GAP_PLANS=3  GAP_TEMPERATURE=0.8  GAP_MAX_QUERIES=4  GAP_QUERY_DUPLICATE_SIMILARITY=0.90

# --- Query hand-out (Stage 1) ---
# A planner query whose bge similarity to the sub-question it was given to is below this is dropped; a sub-question left without queries is
# expanded by the LLM (query_expansion). 0 keeps every query. See question_generator.MIN_ASSIGN_SIMILARITY.
QUERY_MIN_SIMILARITY=0.55

# --- Stage 3: the sub-question itself as an aspect (EXPERIMENTAL, off) ---
# false (default): off.
# judge: the judge and the coverage rule see the sub-question's question as one more aspect; the digest prompt and the chunk selection do not
#        (stored runs Q1 to Q6: 42 of 47 "yes" claims directly answered it; see docs/reports/17_topic_aspect_judge_only.md). A sub-question
#        needs 2 "yes" from 2 sources on it, so "sufficient" is harder to reach.
# true: also in the digest prompt; the digest model then returns about 65% fewer findings (tests/topic_aspect_digest_experiment.py). Do not use.
TOPIC_ASPECT=false

# --- Stage 3: Loop 2, search again for aspects that stayed uncovered (default off; docs/KNOWN_LIMITS.md A1-A6, apps/.../loop2.py) ---
# Ladder per aspect, cheapest first, stopping when the aspect is covered: reselect (unread passages of papers already parsed), pool
# (next-ranked papers of the Stage 2 pool), queries (new search queries -> papers and web pages). Adds minutes and Groq calls.
LOOP2=true
# LOOP2_STEPS=reselect,pool,queries
# LOOP2_MAX_ROUNDS=3
# LOOP2_TRIAGE=r1               r1: search an aspect that has >= LOOP2_MIN_SIGNAL yes/partial verdicts (or no candidates); all: every uncovered aspect
# LOOP2_MIN_SIGNAL=2
# LOOP2_MAX_ASPECTS=8           aspects searched per sub-question
# LOOP2_SYNTHESIS=true          the judge also sees the findings of several sources TOGETHER for an aspect no single claim answers (report 19)
# LOOP2_GAP_RULE=core           core: an aspect still uncovered after the whole search with thin evidence is a known gap and does not block "sufficient"; strict: old rule
# LOOP2_NEARMISS_MIN=3          yes/partial verdicts (from >= 2 sources) that make an uncovered aspect a near miss that keeps blocking
# LOOP2_QUERY_ROUNDS=1          times the queries step runs (new queries each time)
# LOOP2_CANDIDATES_PER_ASPECT=10  findings judged per aspect after Loop 2 added sources
# LOOP2_CHUNKS_PER_ASPECT=2
# LOOP2_POOL_PAPERS=3
# LOOP2_NEW_PAPERS=3
# LOOP2_NEW_WEB=3
# LOOP2_FOCUS_DIGEST=true       the Loop 2 digest prompt names only the aspects being searched
# LOOP2_MAX_SECONDS=1200        time budget of the whole loop in one run

# --- Stage 4: fact checking across sources (default off; docs/reports/TRACE Stage 4 Fact Checking, Handoff Report.md) ---
# Groups the verified claims of Stage 3 that say the same thing, checks that each quote supports its claim, looks for sources that disagree, and
# labels every claim supported (two independent documents) / partially_supported (one document and a close variant in another) / unverified (one document) / contradicted. Results: tables fact_claims, contradictions,
# the report's `factCheck` fields and the run's `factcheck` stage. It adds several hundred small LLM calls per run (Groq) and loads the NLI model
# (about 1.7 GB, downloaded on first use).
FACTCHECK=true
# STAGE4_WORKERS=4               judge calls in parallel
# STAGE4_CACHE=true              judge answers are cached in .cache/stage4_judge: a rerun on the same claims costs no LLM calls
# STAGE4_MAX_MERGE_JUDGE=300     caps per sub-question (a warning is logged when one bites)
# STAGE4_MAX_SUPPORT_JUDGE=150
# STAGE4_MAX_JUDGE=40
# STAGE4_MAX_PAIRS=80          NLI runs on the CPU at about 1.7 s per pair (DeBERTa-large)
# STAGE3_PIPELINE=true            a sub-question is judged as soon as ITS digests are done, while the Groq digests of the others go on (false: all digests first)
# STAGE3_SQ_WORKERS=2            sub-questions judged (judge + coverage + Loop 2) at the same time; 1 = one after the other. Each sends JUDGE_PARALLEL batches to the host
# STAGE4_PARALLEL_STEPS=true      the near-match judge (Groq) runs while the conflict NLI (CPU) computes
# STAGE4_OVERLAP=true            Stage 4 of a sub-question starts as soon as Stage 3 has stored it, while Stage 3 judges the next one (needs FACTCHECK=true; false = Stage 4 after the whole of Stage 3)
# STAGE4_SQ_WORKERS=2           sub-questions Stage 4 checks at the same time (not the judge threads: that is STAGE4_WORKERS). 2 shortens the queue behind the last sub-question (run 32: about 3 min) but doubles the simultaneous Groq calls and the CPU load; default 1 until a real run has measured it
# STAGE3_WARM_CHUNKS=true            embed the chunks of each paper as soon as it is parsed (while the others are still being parsed), into the chunk-embedding cache; needs CHUNK_EMBED_CACHE=true. Run 33: Stage 3 preparation took 2 min right after 4 min of parsing
# STAGE3_WARM_WAIT_SECONDS=180       how long the end of the parse step waits for the last embeddings (0 = do not wait; Stage 3 then embeds the rest itself)
# STAGE3_WARM_ASPECTS=true           split the detail questions into aspects (Groq, cached) right after the planner; Stage 3 finds the answers in the aspect cache
# RUN_TELEMETRY=true               the run's Groq use so far (tokens, calls, rate limits, wait seconds) on every step and stage event (data.groq); false = leave it out
# NLI_CACHE=true                NLI answers cached in .cache/nli (a repeated Stage 4 on the same claims costs no CPU)
# STAGE4_NEAR=true             the partially_supported label: one judge call (about 700 Groq tokens) per single-source claim that has a similar claim in another document
# STAGE4_NEAR_MIN_SIM=0.70     how similar (cosine) a claim of another document must be to be asked about
# STAGE4_NEAR_CANDIDATES=1     candidates per claim (2 doubles the calls for a few more matches)
# STAGE4_RATE_WAIT_MAX=300       a pool-wide Groq limit of at most this many seconds is waited out by a judge call (then it asks again)
# STAGE4_RATE_RETRIES=2        how many times a judge call waits and asks again before failing closed
# STAGE4_MAX_NEAR_JUDGE=120    cap of near-match judge calls per sub-question

# --- Stage 5: the written report (default off; docs/STAGE5.md, docs/STAGE5_OUTPUT.md) ---
# Writes a cited report from the Stage 4 labels: one sentence per job, attributed and hedged by tier (two sources / one related source / one study),
# checked by Python rules, the NLI model and a judge; it never states a single-source claim as fact. Needs the table written_reports (db/migrations/016).
# Costs a few dozen Groq calls per run (stage5_write, stage5_summary, stage5_check in the token meter). A Stage 5 failure never fails the run.
STAGE5=true
STAGE5_MODEL=openai/gpt-oss-120b      # the writer model, through the Groq pool
STAGE5_REASONING_EFFORT=low           # low | medium | high
STAGE5_MAX_OUTPUT_TOKENS=2500         # per call (reasoning tokens count; 1500 was cut off in the first live run)
STAGE5_MAX_PROMPT_TOKENS=4500         # a section that does not fit is split into several calls (about 4 characters per token)
STAGE5_TEMPERATURE=0.2
STAGE5_RETRIES=1                      # a rejected sentence is asked again once with the reasons, then the deterministic sentence is used
STAGE5_WORKERS=3                      # calls at the same time
STAGE5_CACHE=true                     # validated replies are cached in STAGE5_CACHE_DIR: a rerun on the same claims costs no LLM calls
STAGE5_CACHE_DIR=.cache/stage5
STAGE5_RATE_WAIT_MAX=300              # a pool-wide Groq limit of at most this many seconds is waited out (then it asks again)
STAGE5_RATE_RETRIES=2                 # how many times a call waits and asks again
STAGE5_BREAKER_SECONDS=300            # after a limit that cannot be waited out the model is not asked again for this long (deterministic sentences)
STAGE5_MAX_PER_SOURCE=3               # at most this many single-source claims from one document
STAGE5_SINGLE_NEEDS_STRONG=true       # a single-source claim needs full text or the Stage 3 judge behind it
STAGE5_SCOPE_CHECK=false              # NLI check that a claim is not broader than its quote (loads the NLI model)
STAGE5_MAX_SINGLE_PER_SECTION=8       # at most this many single-source claims per section
STAGE5_ENTAIL_MIN=0.5                 # a written sentence must be entailed by its claims and quotes at least this much (NLI) ...
STAGE5_CONTRA_MIN=0.5                 # ... and is rejected at once when contradicted at least this much
STAGE5_JUDGE_MIN=0.7                  # otherwise the judge must confirm it with at least this confidence

# --- API server (apps/api/main.py; run: uvicorn apps.api.main:app --port 8000) ---
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000   origins of the web frontend (comma separated)
# MAX_CONCURRENT_RUNS=1      runs executed at the same time (a run uses the model server, Groq and the parsers)
# MAX_PENDING_RUNS=5         queued runs beyond the running ones; more get HTTP 429
# MAX_RUNS_IN_MEMORY=200     finished runs kept in memory (their report stays in the database)
