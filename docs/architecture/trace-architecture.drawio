<mxfile host="trace" version="2" type="device"><diagram id="trace-0" name="0 Overview"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1820" pageHeight="1400" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;TRACE: from a research question to a fact-checked evidence report&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1740" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Overview of the pipeline (version of 10 Nov 2026). Each stage has its own detailed page; numbers on the arrows are from run 32." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1740" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Research question&lt;/b&gt;&lt;br&gt;typed in the web app, sent to the API" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="80" width="320" height="56" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Stage 1: Planner&lt;/b&gt;&lt;br&gt;Splits the question into sub-questions with search queries and fixes the field of the search (domain anchor).&lt;br&gt;Uses: model host (fine-tuned Qwen3.5-9B planner) and Groq (domain anchor).  Run 32: 8 s (plan from cache)." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="190" width="760" height="100" as="geometry"/></mxCell><mxCell id="n5" value="Stage 2: Retrieval, two branches &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; at the same time" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="520" y="370" width="760" height="250" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Paper retrieval&lt;/b&gt;&lt;br&gt;arXiv, Semantic Scholar, IEEE, OpenAlex, Scopus → embedding pre-filter → relevance judge → reliability score → download and parse the top papers (Docling)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n5"><mxGeometry x="15" y="40" width="360" height="120" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Web search&lt;/b&gt;&lt;br&gt;Tavily, Exa, Parallel: three query variants per sub-question → de-duplicate → store" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n5"><mxGeometry x="385" y="40" width="360" height="120" as="geometry"/></mxCell><mxCell id="n8" value="Uses: search APIs, model host (relevance judge, Docling parser), local embedder (bge). Run 32: about 1m 52s." style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n5"><mxGeometry x="15" y="175" width="735" height="60" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Stage 3: Summarizer&lt;/b&gt;&lt;br&gt;Reads the best sources into digests (claim + verified quote), judges which aspects of every sub-question are covered, and searches again for the gaps (Loop 2).&lt;br&gt;Uses: Groq (digests), model host (judge-v2), local embedder.  Run 32: 5m 24s." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="710" width="760" height="110" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Stage 4: Fact check&lt;/b&gt;&lt;br&gt;Groups claims that say the same thing, checks that each quote backs its claim, finds close variants and conflicts in other sources, and labels every claim.&lt;br&gt;Uses: Groq (judges), local NLI model (DeBERTa) and embedder.  Run 32: about 11 min of work, the first 4m 48s while Stage 3 still ran &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt;." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="520" y="920" width="760" height="120" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Stage 5: Report generator (not built yet)&lt;/b&gt;&lt;br&gt;Will write the final report from the labelled claims: every claim cited, a confidence per claim, unverified claims never stated as fact." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="520" y="1150" width="760" height="84" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Final report&lt;/b&gt;&lt;br&gt;today: the evidence report the API builds from the database" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=12;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="740" y="1290" width="320" height="60" as="geometry"/></mxCell><mxCell id="n13" value="research question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="task plan: 4 sub-questions, 11 queries,&lt;br&gt;domain anchor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="61 papers kept (20 parsed to full text),&lt;br&gt;48 web sources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="129 findings (121 with a verified quote);&lt;br&gt;4 of 4 sub-questions judged sufficient" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="89 claims: 4 supported, 35 partially supported,&lt;br&gt;49 unverified, 1 contradicted" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n10" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="report with cited, labelled claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n11" target="n12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;Loop 2 (built)&lt;/b&gt;&lt;br&gt;for an aspect still uncovered after judging: re-read passages, parse the next papers of the pool, then search with new queries; judge again after each step&lt;br&gt;run 32: 1 aspect searched, 288 s" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1420" y="720" width="360" height="100" as="geometry"/></mxCell><mxCell id="n20" value="gaps" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#d79b00;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n9" target="n19" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Loop 3 (not built)&lt;/b&gt;&lt;br&gt;when most claims stay unverified or contradicted, Stage 4 only sets a needs_replan flag; nothing re-plans yet" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1420" y="930" width="360" height="70" as="geometry"/></mxCell><mxCell id="n22" value="flag" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n10" target="n21" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="Outside services (not part of the code)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#fff2cc;strokeColor=#d6b656;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="100" width="420" height="700" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Model host (Tailscale, other machine)&lt;/b&gt;&lt;br&gt;fine-tuned Qwen3.5-9B planner (LoRA, vLLM), evidence judge judge-v2, Docling PDF parser&lt;br&gt;used by stages 1, 2, 3" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="15" y="40" width="390" height="120" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Groq (7 free keys in one pool)&lt;/b&gt;&lt;br&gt;openai/gpt-oss-120b: domain anchor, aspect split, digests, Stage 4 judges&lt;br&gt;per-minute and daily token limits per key&lt;br&gt;used by stages 1, 3, 4" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="15" y="180" width="390" height="130" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;Search and access APIs&lt;/b&gt;&lt;br&gt;OpenAlex, Scopus, arXiv, IEEE, Semantic Scholar, Unpaywall; Tavily, Exa, Parallel&lt;br&gt;used by stage 2 (and Loop 2)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="15" y="330" width="390" height="110" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Local models (this machine, CPU only)&lt;/b&gt;&lt;br&gt;bge-base-en-v1.5 embedder, DeBERTa-v3-large NLI&lt;br&gt;used by stages 2, 3, 4" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="15" y="460" width="390" height="100" as="geometry"/></mxCell><mxCell id="n28" value="These are named on the stage boxes under 'Uses:'. They are not drawn as arrows so the flow stays readable; each stage page shows exactly which step calls which service." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="n23"><mxGeometry x="15" y="580" width="390" height="140" as="geometry"/></mxCell><mxCell id="n29" value="Stored data" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#f5f5f5;strokeColor=#666666;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1420" y="100" width="360" height="560" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Supabase (Postgres)&lt;/b&gt;&lt;br&gt;research_queries, sub_questions, retrieved_papers, web_sources, parsed_papers, pdf_failures, digests, coverage_results, fact_claims, contradictions" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="n29"><mxGeometry x="15" y="40" width="330" height="120" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Disk caches (they save Groq tokens and time)&lt;/b&gt;&lt;br&gt;plan, digests (content scope), judge verdicts, aspect split, chunk embeddings, Stage 4 judge answers, NLI answers" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n29"><mxGeometry x="15" y="180" width="330" height="110" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Logs and run reports&lt;/b&gt;&lt;br&gt;logs/pipeline.log and one file per stage; scripts/pipeline_run_report.py writes the Markdown run report" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n29"><mxGeometry x="15" y="310" width="330" height="100" as="geometry"/></mxCell><mxCell id="n33" value="Stage 5 and the web app read the stored data, not the stage objects: the API builds the report from the database." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="n29"><mxGeometry x="15" y="430" width="330" height="110" as="geometry"/></mxCell><mxCell id="n34" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="840" width="470" height="236" as="geometry"/></mxCell><mxCell id="n35" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n34"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n36" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n37" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n34"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n38" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n39" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n34"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n40" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n41" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n34"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n42" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n43" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n44" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n34"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell><mxCell id="n45" value="&lt;b&gt;Where to look next&lt;/b&gt;&lt;br&gt;Pages 1 to 5: one page per stage (inputs, steps, services, settings, what happens on failure).&lt;br&gt;Page A: the web app, API and run manager around the graph.&lt;br&gt;Page B: everything that runs at the same time.&lt;br&gt;Page C: where the time of runs 30 and 32 went." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1100" width="420" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-1" name="1 Stage 1: Planner"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1200" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Stage 1: Planner (node planner)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1820" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Question answered here: which sub-questions must be answered, and what do we search for each?" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1820" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;INPUT&lt;/b&gt;&lt;br&gt;Research question (text)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="220" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Plan already stored for this question?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="300" y="120" width="200" height="130" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Planner model&lt;/b&gt;&lt;br&gt;Fine-tuned Qwen3.5-9B (LoRA, Unsloth) served by vLLM on the model host; POST /decompose returns sub-questions, detail questions and search queries" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="560" y="110" width="320" height="120" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Fallback: Groq decomposition&lt;/b&gt;&lt;br&gt;only if the model server is unreachable (TRACE_LLM_FALLBACK=groq); purpose planner_fallback; this plan is never cached" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="560" y="290" width="320" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Stored plan (.cache/plans)&lt;/b&gt;&lt;br&gt;PLAN_CACHE: a rerun of the same question plans the same way (the adapter is not reproducible: three calls at temperature 0 gave three plans). Plans from the Groq fallback are not stored" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="240" y="470" width="300" height="140" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Build the sub-questions&lt;/b&gt;&lt;br&gt;at most 5 sub-questions and 3 queries each&lt;br&gt;identical sub-questions are merged (same content words)&lt;br&gt;queries are handed out evenly; one below cosine 0.55 to its sub-question is dropped (bge)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="150" width="320" height="150" as="geometry"/></mxCell><mxCell id="n9" value="A sub-question without any query?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1300" y="120" width="200" height="130" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Query expansion&lt;/b&gt;&lt;br&gt;Groq gpt-oss-120b writes 2 to 4 query variants for that sub-question" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="300" width="220" height="100" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Domain anchor (Groq, cached per question)&lt;/b&gt;&lt;br&gt;1 to 3 words naming the field are added to every query and to the pre-filter text; one sentence of context goes to the relevance judge&lt;br&gt;stops 'transformers' returning electrical transformers" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1560" y="120" width="300" height="170" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;Task plan saved (Supabase)&lt;/b&gt;&lt;br&gt;research_queries and sub_questions; the run is announced to Stage 4 (expect) so it may start early" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1560" y="380" width="300" height="120" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;NLI preload &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P6]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;a thread loads the DeBERTa model now so Stage 4 does not wait for it" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="440" width="220" height="100" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;OUTPUT to Stage 2&lt;/b&gt;&lt;br&gt;task plan: sub-questions with detail questions and queries, the domain anchor and its context" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1560" y="560" width="300" height="110" as="geometry"/></mxCell><mxCell id="n15" value="question" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="yes: reuse" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="server down" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n19" value="plan as JSON" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n6" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="stored plan" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n7" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="sub-questions" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n9" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n24" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n9" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;entryX=0;entryY=0.85;" edge="1" source="n10" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="anchored queries" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n11" target="n12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n12" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="also" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n12" target="n13" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Settings (.env)&lt;/b&gt;&lt;br&gt;MAX_SUBQUESTIONS=5, MAX_QUERIES_PER_SUBQUESTION=3&lt;br&gt;SUBQUESTION_MERGE=exact, QUERY_MIN_SIMILARITY=0.55&lt;br&gt;PLAN_CACHE=true (PLAN_CACHE_TAG starts over after a prompt change)&lt;br&gt;DOMAIN_ANCHOR on; TRACE_LLM_URL = the model host&lt;br&gt;TRACE_LLM_FALLBACK=groq" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="740" width="593" height="150" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;If something fails&lt;/b&gt;&lt;br&gt;Planner server unreachable: the Groq decomposition is used and not cached.&lt;br&gt;Domain anchor call fails: the anchor stays empty and the pipeline searches as before (nothing breaks).&lt;br&gt;A sub-question left without queries is expanded by the Groq call; a bad planner reply gives an error to the API (the run fails at Stage 1)." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="653" y="740" width="593" height="150" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Measured in run 32 (diffusion models vs GANs, 13m 54s)&lt;/b&gt;&lt;br&gt;8 s, plan taken from the cache.&lt;br&gt;4 sub-questions, 11 queries (3, 2, 3, 3); anchor 'generative modeling'.&lt;br&gt;Without the cache the planner call takes longer and the plan differs from run to run, which is why the cache exists." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1266" y="740" width="593" height="150" as="geometry"/></mxCell><mxCell id="n32" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="470" height="236" as="geometry"/></mxCell><mxCell id="n33" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n34" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n35" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n36" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n37" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n38" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n39" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n32"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n40" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n41" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n42" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-2" name="2 Stage 2: Retrieval"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2000" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Stage 2: Retrieval and scoring (nodes paper_retrieval and web_search, &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; at the same time)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1920" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Question answered here: which papers and web pages could answer each sub-question, and which of them can we actually read?" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1920" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;INPUT from Stage 1&lt;/b&gt;&lt;br&gt;task plan: sub-questions, queries, domain anchor" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="300" height="70" as="geometry"/></mxCell><mxCell id="n4" value="Paper branch (paper_retrieval node)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="190" width="1260" height="1050" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;1. Search every sub-question at once &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;OpenAlex (rerank + semantic) · Scopus · arXiv · IEEE · Semantic Scholar (probed first; skipped for the run on HTTP 429, as in run 32); key pools with rotation and per-source rate limits" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="20" y="45" width="560" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;2. Embedding pre-filter (local bge-base-en-v1.5)&lt;/b&gt;&lt;br&gt;a candidate must reach similarity 0.56 to its sub-question (the domain anchor is part of the text); the 20 best per sub-question go on" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="20" y="195" width="560" height="100" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;3. Relevance judge &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P4]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;model host judge: is this paper about the sub-question (with the field context)? Several sub-questions at once: RELEVANCE_WORKERS=2, each with JUDGE_WORKERS=8 requests; the shared embedder is serialised&lt;br&gt;rejected papers keep the judge's reason" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="20" y="335" width="560" height="140" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;4. Reliability score and citation counts&lt;/b&gt;&lt;br&gt;trusted domains, top venues and recency give a reliability score; combined with relevance into combined_score, used to rank (Semantic Scholar citation batch when it is available)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="20" y="515" width="560" height="110" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;5. Store the kept papers (Supabase retrieved_papers)&lt;/b&gt;&lt;br&gt;title, abstract, links, scores; run 32 kept 61 of 80 shortlisted" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="n4"><mxGeometry x="20" y="665" width="560" height="90" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;6. Parse the top papers &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P5]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;PARSE_TOP_N_PER_SUBQUESTION=5 per sub-question; papers with a recorded PDF failure are tried last; get the PDF, then Docling (model host) turns it into Markdown and sections; parse cache and failure memory" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="20" y="795" width="560" height="130" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;Parsed text (Supabase parsed_papers)&lt;/b&gt;&lt;br&gt;full text kept per paper; a paper that cannot be parsed stays abstract-only" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="n4"><mxGeometry x="20" y="960" width="560" height="70" as="geometry"/></mxCell><mxCell id="n12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n6" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n6" target="n7" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n7" target="n8" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n8" target="n9" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n9" target="n10" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n10" target="n11" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="Routes to a PDF (pdf_sources.py); each is a switch" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="n4"><mxGeometry x="640" y="560" width="600" height="340" as="geometry"/></mxCell><mxCell id="n19" value="The paper's own PDF link (polite: honest User-Agent, spacing per host, robots.txt for pages only followed)&lt;br&gt;&lt;br&gt;Unpaywall open-access link&lt;br&gt;&lt;br&gt;OpenAlex content API (its cached open-access PDFs)&lt;br&gt;&lt;br&gt;Repository APIs (OSF, Zenodo)&lt;br&gt;&lt;br&gt;arXiv twin of the paper (matched by exact title)&lt;br&gt;&lt;br&gt;Landing page citation_pdf_url, then the HTML full text&lt;br&gt;&lt;br&gt;Headless browser as the last attempt&lt;br&gt;&lt;br&gt;Docling can also fetch by URL&lt;br&gt;&lt;br&gt;A file counts as a PDF only if it starts with %PDF- and has the minimum size. Publishers that block scripts (HTTP 403) are not bypassed: the paper stays abstract-only." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n18"><mxGeometry x="14" y="36" width="570" height="300" as="geometry"/></mxCell><mxCell id="n20" value="tries the routes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n10" target="n18" parent="n4"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Parallel inside the paper branch&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt; searches of all sub-questions and sources run as asyncio tasks&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P4]&lt;/b&gt;&lt;/font&gt; relevance filter across sub-questions&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P5]&lt;/b&gt;&lt;/font&gt; downloads and parses run as concurrent tasks, bounded per host&lt;br&gt;the paper node and the web node themselves run side by side &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="640" y="45" width="600" height="130" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;Services called by this branch&lt;/b&gt;&lt;br&gt;search APIs (step 1, step 4), model host judge (step 3), model host Docling (step 6), local embedder (step 2)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n4"><mxGeometry x="640" y="215" width="600" height="90" as="geometry"/></mxCell><mxCell id="n23" value="Web branch (web_search node)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1340" y="190" width="620" height="560" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;1. Search the web &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Tavily (5 results per query) · Exa · Parallel; about 3 query variants per sub-question; key pools rotate on HTTP 429; web search is also part of the Loop 2 query step" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="20" y="45" width="580" height="120" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;2. De-duplicate&lt;/b&gt;&lt;br&gt;one entry per URL per sub-question: 10 to 15 sources (run 32: 12, 10, 11, 12)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n23"><mxGeometry x="20" y="200" width="580" height="90" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;3. Store (Supabase web_sources)&lt;/b&gt;&lt;br&gt;title, URL, snippet, provider; Stage 3 reads snippets of at least 200 characters" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="n23"><mxGeometry x="20" y="330" width="580" height="100" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n24" target="n25" parent="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n25" target="n26" parent="n23"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="Web pages are never parsed in this stage; Stage 3 uses their snippets (13 of the 42 digests in run 32)." style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="n23"><mxGeometry x="20" y="450" width="580" height="90" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P2]&lt;/b&gt;&lt;/font&gt; Join: the summarizer starts when both branches are done&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1280" width="620" height="40" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;OUTPUT to Stage 3&lt;/b&gt;&lt;br&gt;per sub-question: kept papers with scores and parsed full text, and web sources with snippets" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1100" y="1350" width="620" height="80" as="geometry"/></mxCell><mxCell id="n32" value="kept papers + parsed text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="web sources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n23" target="n30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n30" target="n31" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n23" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Settings (.env)&lt;/b&gt;&lt;br&gt;PARSE_TOP_N_PER_SUBQUESTION=5, min_similarity 0.56, top 20&lt;br&gt;RELEVANCE_WORKERS=2, JUDGE_WORKERS=8&lt;br&gt;per-route switches: OPENALEX_CONTENT, REPOSITORY_APIS, ARXIV_TITLE_TWIN, HTML_FULLTEXT, RESPECT_ROBOTS_TXT&lt;br&gt;key lists: OPENALEX_API_KEYS, TAVILY_API_KEYS, EXA_API_KEYS, PARALLEL_API_KEYS" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1470" width="626" height="150" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;If something fails&lt;/b&gt;&lt;br&gt;A search source that fails is skipped; Semantic Scholar gives up on HTTP 429 for the whole run.&lt;br&gt;A key that is rate limited is rotated out; with no key left the source returns nothing for now.&lt;br&gt;A PDF that cannot be fetched or parsed is recorded (pdf_failures) and tried last next time; the paper stays abstract-only.&lt;br&gt;The relevance judge never rejects without a reason." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="686" y="1470" width="626" height="150" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Measured in run 32 (diffusion models vs GANs, 13m 54s)&lt;/b&gt;&lt;br&gt;web 12 s, paper search 34 s, filter 53 s, parse 11 s (20 of 21 attempted papers from the parse cache).&lt;br&gt;368 candidates, 80 shortlisted, 61 kept (21 rejected); 48 web sources.&lt;br&gt;Semantic Scholar gave HTTP 429 and was skipped; Supabase 'server disconnected' warnings were retried." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1332" y="1470" width="626" height="150" as="geometry"/></mxCell><mxCell id="n40" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1650" width="470" height="236" as="geometry"/></mxCell><mxCell id="n41" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n42" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n43" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n44" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n45" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n46" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n47" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n40"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n48" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n49" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n50" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-3" name="3 Stage 3: Summarizer"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2060" pageHeight="1500" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Stage 3: Summarizer (node summarizer) with Loop 2&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1980" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Question answered here: what do the sources say about each aspect of each sub-question, and is that enough?" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1980" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;INPUT from Stage 2&lt;/b&gt;&lt;br&gt;parsed papers (full text) and web snippets of one sub-question, best first" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="230" height="100" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;1. Aspect split&lt;/b&gt;&lt;br&gt;Groq, cached: each detail question becomes aspects; identical aspects merged &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P7]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="300" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;2. Chunk and select&lt;/b&gt;&lt;br&gt;300-word chunks (references skipped); the 5 most similar to the aspects (bge, chunk-embedding cache) &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P7]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="585" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;3. Digest per source&lt;/b&gt;&lt;br&gt;Groq gpt-oss-120b: findings = claim + quote + stance; a finding is verified when its quote is found in the text; 7 workers, one per key &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P8]&lt;/b&gt;&lt;/font&gt;; digest cache" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="870" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;4. Candidates&lt;/b&gt;&lt;br&gt;findings paired with aspects, trimmed by rank per aspect" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1155" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;5. Evidence judge&lt;/b&gt;&lt;br&gt;model host judge-v2: yes / partial / no per (finding, aspect); verdict cache; 2 batches at once &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P11]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1440" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;6. Coverage check&lt;/b&gt;&lt;br&gt;covered = 2 yes from 2 sources; several partial findings can be combined (synthesis); core-gap rule" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1725" y="80" width="225" height="190" as="geometry"/></mxCell><mxCell id="n10" value="sources" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="aspects" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n12" value="best chunks" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n6" target="n7" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="pairs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n7" target="n8" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n15" value="verdicts" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n8" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="Everything covered, or only gaps with no evidence?" style="rhombus;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#666666;spacingLeft=14;spacingRight=14;" vertex="1" parent="1"><mxGeometry x="1687" y="330" width="300" height="140" as="geometry"/></mxCell><mxCell id="n17" value="coverage per aspect" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n9" target="n16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;7. Store, then queue Stage 4 &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;Supabase digests and coverage_results, written per sub-question; the sub-question goes to Stage 4 at once" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="1687" y="520" width="300" height="130" as="geometry"/></mxCell><mxCell id="n19" value="yes" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n16" target="n18" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="Loop 2: the cheapest source of new evidence first (LOOP2=true, steps in LOOP2_STEPS)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="1580" height="470" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;Triage&lt;/b&gt;&lt;br&gt;searched: aspects with 2 or more yes/partial verdicts, or no candidates at all&lt;br&gt;recorded as known gap, not searched: aspects with only 'no' verdicts" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="20" y="50" width="250" height="130" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;a. reselect&lt;/b&gt;&lt;br&gt;re-read passages of the papers already parsed that the first digest did not read (no download)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="310" y="50" width="250" height="130" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;b. pool&lt;/b&gt;&lt;br&gt;parse the next-ranked papers of the Stage 2 pool and read their best passages" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="600" y="50" width="250" height="130" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;c. queries&lt;/b&gt;&lt;br&gt;new queries for the aspect (planner with several plans, bge de-duplication, domain anchor), then retrieve, filter, store, parse and read; searches run in parallel" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="890" y="50" width="300" height="130" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;Stop rules&lt;/b&gt;&lt;br&gt;LOOP2_MAX_ROUNDS steps per aspect, an aspect limit, a time limit&lt;br&gt;stop when every digest of a step failed: an empty result after failed digests is not trusted" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="1230" y="50" width="310" height="130" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n21" target="n22" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n22" target="n23" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="open" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n23" target="n24" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n24" target="n25" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;After every step that added sources: judge again and recompute coverage&lt;/b&gt;&lt;br&gt;the verdict cache means only the new (finding, aspect) pairs cost anything; the ladder stops for an aspect as soon as it is covered" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="310" y="240" width="880" height="90" as="geometry"/></mxCell><mxCell id="n31" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n22" target="n30" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n23" target="n30" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n24" target="n30" parent="n20"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Result per aspect&lt;/b&gt;&lt;br&gt;covered (single claims or synthesis) · still uncovered · known gap with no evidence · unjudged (a verdict failed; it never triggers a search). A sub-question is 'sufficient' when no blocking aspect is left; the strict rule and the core-gap rule are both recorded." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n20"><mxGeometry x="20" y="370" width="1520" height="70" as="geometry"/></mxCell><mxCell id="n35" value="no" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n16" target="n20" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="&lt;b&gt;Where it runs at the same time&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P7]&lt;/b&gt;&lt;/font&gt; STAGE3_PREP_WORKERS=4 sub-questions prepared side by side&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P8]&lt;/b&gt;&lt;/font&gt; digest pool of 7 workers&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P9]&lt;/b&gt;&lt;/font&gt; STAGE3_PIPELINE: a sub-question is judged as soon as ITS digests are done&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P10]&lt;/b&gt;&lt;/font&gt; STAGE3_SQ_WORKERS=2 sub-questions judged at once&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P11]&lt;/b&gt;&lt;/font&gt; JUDGE_PARALLEL=2 batches" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1687" y="690" width="300" height="210" as="geometry"/></mxCell><mxCell id="n37" value="&lt;b&gt;Settings (.env)&lt;/b&gt;&lt;br&gt;MAX_PAPERS, MAX_WEB per sub-question; JUDGE_MODEL_ID=judge-v2&lt;br&gt;STAGE3_PREP_WORKERS=4, STAGE3_PIPELINE=true, STAGE3_SQ_WORKERS=2, JUDGE_PARALLEL=2&lt;br&gt;LOOP2=true, LOOP2_STEPS=reselect,pool,queries, LOOP2_MAX_ROUNDS&lt;br&gt;DIGEST_CACHE_SCOPE=content (id restores per-run scope), TOPIC_ASPECT=judge" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="930" width="646" height="150" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;If something fails&lt;/b&gt;&lt;br&gt;A digest that fails counts in digest_failures; nothing is invented.&lt;br&gt;A judge verdict that fails is 'unjudged': the aspect is not covered and not searched again.&lt;br&gt;If one sub-question raises, the others write nothing and the run fails at Stage 3.&lt;br&gt;Groq 429: the key pool rotates and waits; progress events are held until the digest step ends, then replayed with occurredAt." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="706" y="930" width="646" height="150" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Measured in run 32 (diffusion models vs GANs, 13m 54s)&lt;/b&gt;&lt;br&gt;5m 24s (13:10:22 to 13:15:46); 42 digests (29 from full text, 13 from web snippets).&lt;br&gt;129 findings, 121 verified; 4 of 4 sub-questions sufficient; judge 11 batches (4.5 to 29.5 s), 0 errors.&lt;br&gt;Loop 2 searched 1 aspect and covered it in 288 s: it decided when Stage 3 ended. 6 aspects stay known gaps without evidence." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1372" y="930" width="646" height="150" as="geometry"/></mxCell><mxCell id="n40" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1170" width="470" height="236" as="geometry"/></mxCell><mxCell id="n41" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n42" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n43" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n44" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n45" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n40"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n46" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n47" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n40"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n48" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n49" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n50" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n40"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-4" name="4 Stage 4: Fact check"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="1460" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Stage 4: Fact check (node factcheck)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1820" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Question answered here: which findings are backed by more than one source, and where do sources disagree?" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1820" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;INPUT from Stage 3&lt;/b&gt;&lt;br&gt;verified findings (claim + quote + source) of one sub-question, from the stored digests" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;1. Claims&lt;/b&gt;&lt;br&gt;load the findings as claims with their quotes and sources" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="320" y="90" width="230" height="110" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;2. Clusters&lt;/b&gt;&lt;br&gt;group claims that say the same thing: bge embeddings, then the same-claim judge (Groq, stage4_merge)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="600" y="90" width="330" height="110" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;3. Support&lt;/b&gt;&lt;br&gt;does each member's quote back its claim?  a) reuse Stage 3's judge 'yes' (model host, no Groq)  b) else NLI (DeBERTa, cached)  c) else the support judge (Groq, stage4_support)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="980" y="90" width="560" height="110" as="geometry"/></mxCell><mxCell id="n7" value="findings" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n4" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="clusters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;4a. Near match &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt; (Groq, stage4_near)&lt;/b&gt;&lt;br&gt;for a cluster with one document: look for a similar claim in another document (cosine 0.70 or more, 1 candidate); the judge must name the shared point&lt;br&gt;result: evidence row near_match, confidence 0.6 or less" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="640" y="290" width="440" height="150" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;4b. Conflicts &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt; (NLI on CPU, then Groq stage4_conflict)&lt;/b&gt;&lt;br&gt;pairs that pass the topic gate: the 80 most similar go to NLI (STAGE4_MAX_PAIRS)&lt;br&gt;conflict judge, then a second CONFIRM reading that needs the loophole in the actual words; confirmed pairs become disagreements" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1120" y="290" width="520" height="150" as="geometry"/></mxCell><mxCell id="n12" value="single-document clusters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n6" target="n10" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n13" value="clusters" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n6" target="n11" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;5. Label&lt;/b&gt;&lt;br&gt;every cluster gets exactly one label" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="880" y="500" width="340" height="70" as="geometry"/></mxCell><mxCell id="n15" value="near matches" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n10" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="disagreements" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n11" target="n14" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n17" value="The four labels" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="600" y="630" width="1060" height="150" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;supported&lt;/b&gt;&lt;br&gt;2 or more distinct documents, weight 1.5 or more" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n17"><mxGeometry x="20" y="42" width="240" height="90" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;partially_supported&lt;/b&gt;&lt;br&gt;1 document + a judge-confirmed close variant in another" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n17"><mxGeometry x="280" y="42" width="240" height="90" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;unverified&lt;/b&gt;&lt;br&gt;one document, nothing similar elsewhere" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n17"><mxGeometry x="540" y="42" width="240" height="90" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;contradicted&lt;/b&gt;&lt;br&gt;a confirmed opposite from another source" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n17"><mxGeometry x="800" y="42" width="240" height="90" as="geometry"/></mxCell><mxCell id="n22" value="label" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n14" target="n17" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;6. Store (Supabase)&lt;/b&gt;&lt;br&gt;fact_claims and contradictions; the report shows labels, evidence rows and disagreements" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="880" y="830" width="340" height="100" as="geometry"/></mxCell><mxCell id="n24" value="labelled claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n17" target="n23" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n25" value="&lt;b&gt;OUTPUT to Stage 5 and the web app&lt;/b&gt;&lt;br&gt;labelled claims with evidence rows, disagreements, counts per label (docs/STAGE4_OUTPUT.md)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1300" y="840" width="340" height="90" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n23" target="n25" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;How it runs&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt; each sub-question is queued the moment Stage 3 stored it, on background workers (STAGE4_OVERLAP=true)&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P13]&lt;/b&gt;&lt;/font&gt; STAGE4_SQ_WORKERS=1 by default: one sub-question at a time; 2 is a switch&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt; the near-match judge (Groq) runs beside the conflict check (NLI on CPU)&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P15]&lt;/b&gt;&lt;/font&gt; STAGE4_WORKERS=4 judge calls at once inside one sub-question&lt;br&gt;progress steps are held and replayed when the factcheck stage starts (occurredAt keeps the real time), so the stage duration understates the real work" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="240" width="520" height="250" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;Services called by this stage&lt;/b&gt;&lt;br&gt;Groq: same-claim, support, near-match and conflict judges&lt;br&gt;model host: Stage 3's stored judge answers are reused for support (no call)&lt;br&gt;local: bge embedder, DeBERTa NLI (preloaded in Stage 1)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="520" width="520" height="130" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Settings (.env)&lt;/b&gt;&lt;br&gt;FACTCHECK=true, STAGE4_OVERLAP=true, STAGE4_SQ_WORKERS=1&lt;br&gt;STAGE4_WORKERS=4, STAGE4_PARALLEL_STEPS=true, STAGE4_NEAR=true&lt;br&gt;STAGE4_MAX_PAIRS=80, STAGE4_RATE_WAIT_MAX=300, STAGE4_RATE_RETRIES=2&lt;br&gt;STAGE4_CACHE and NLI_CACHE (disk caches)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="1000" width="593" height="150" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;If something fails&lt;/b&gt;&lt;br&gt;Every judge fails closed: an error means no conflict, no support, not the same claim.&lt;br&gt;Judge answers and NLI answers are cached on disk; a failed call is never cached.&lt;br&gt;A pool-wide Groq limit up to 300 s is waited out (judgeWaits); a longer limit opens a 300 s breaker and calls fail closed (judgeFailures).&lt;br&gt;A sub-question that raises is logged and skipped; it never fails the run." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="653" y="1000" width="593" height="150" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Measured in run 32 (diffusion models vs GANs, 13m 54s)&lt;/b&gt;&lt;br&gt;about 11 min of work: sub-questions finished at 342, 524, 653 and 833 s of the run.&lt;br&gt;89 claims: 4 supported, 35 partially supported, 49 unverified, 1 contradicted; 3 disagreements, all real.&lt;br&gt;Groq 157k tokens (near 60k, merge 59k, support 22k, conflict 15k). Conflict judge on 41 labelled pairs: precision 0.71, recall 0.56." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1266" y="1000" width="593" height="150" as="geometry"/></mxCell><mxCell id="n32" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1190" width="470" height="236" as="geometry"/></mxCell><mxCell id="n33" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n34" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n35" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n36" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n37" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n32"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n38" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n39" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n32"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n40" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n41" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n42" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n32"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-5" name="5 Stage 5: Report (planned)"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Stage 5: Report generator (planned, not built)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=18;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1620" height="26" as="geometry"/></mxCell><mxCell id="n2" value="Question answered here: how do we present the findings so that every statement can be traced to a source?" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#555555;" vertex="1" parent="1"><mxGeometry x="40" y="42" width="1620" height="22" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;Status&lt;/b&gt;&lt;br&gt;apps/api/agents/stage5_report/report_generator.py is empty. Today the 'report' is the evidence report that the API builds from the database (GET /api/research/{id}/report). Everything on this page is design intent (the earlier architecture diagram plus proposals, marked), drawn dashed." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="80" width="1620" height="90" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;INPUT from Stage 4 (docs/STAGE4_OUTPUT.md)&lt;/b&gt;&lt;br&gt;per sub-question: labelled claims with evidence rows (quote, source, relation), disagreements, counts per label&lt;br&gt;plus the Stage 3 coverage verdict and known gaps" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="220" width="400" height="140" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Planned: report generator&lt;/b&gt;&lt;br&gt;From the earlier design: synthesize the verified claims, cite the sources of every claim, flag a confidence per claim, never present an unverified claim as fact&lt;br&gt;Proposed, not decided: show disagreements between sources instead of choosing silently; list the known gaps (aspects with no evidence)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="540" y="220" width="520" height="170" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Planned OUTPUT: final report&lt;/b&gt;&lt;br&gt;readable report with citations, shown in the web app and downloadable" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="1160" y="220" width="500" height="100" as="geometry"/></mxCell><mxCell id="n7" value="labelled claims" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n4" target="n5" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n8" value="report text" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n5" target="n6" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Proposed rules (my suggestion, nothing is decided)&lt;/b&gt;&lt;br&gt;the label decides how a claim may be written: supported = stated; partially_supported = stated with the near-match source named; unverified = listed as single-source; contradicted = shown with both sides&lt;br&gt;every number and quote comes from a stored evidence row" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="40" y="430" width="800" height="130" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Open questions&lt;/b&gt;&lt;br&gt;which model writes it (Groq gpt-oss-120b or the model host)&lt;br&gt;how long the report may be and how it is structured per sub-question&lt;br&gt;how the needs_replan flag (Loop 3) should interact with it" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="1"><mxGeometry x="880" y="430" width="780" height="130" as="geometry"/></mxCell><mxCell id="n11" value="How to read this page" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffffff;strokeColor=#999999;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="620" width="470" height="236" as="geometry"/></mxCell><mxCell id="n12" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n11"><mxGeometry x="14" y="36" width="34" height="22" as="geometry"/></mxCell><mxCell id="n13" value="Step of the stage (colour = stage)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="60" y="38" width="400" height="20" as="geometry"/></mxCell><mxCell id="n14" value="" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n11"><mxGeometry x="14" y="66" width="34" height="22" as="geometry"/></mxCell><mxCell id="n15" value="Outside service (model host, Groq, search APIs, local model)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="60" y="68" width="400" height="20" as="geometry"/></mxCell><mxCell id="n16" value="" style="shape=cylinder3;boundedLbl=1;size=5;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n11"><mxGeometry x="14" y="96" width="34" height="22" as="geometry"/></mxCell><mxCell id="n17" value="Stored data or cache" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="60" y="98" width="400" height="20" as="geometry"/></mxCell><mxCell id="n18" value="" style="rhombus;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#666666;" vertex="1" parent="n11"><mxGeometry x="14" y="126" width="34" height="22" as="geometry"/></mxCell><mxCell id="n19" value="Decision" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="60" y="128" width="400" height="20" as="geometry"/></mxCell><mxCell id="n20" value="&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt;  red tag = work that runs at the same time (page B lists all)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="14" y="156" width="440" height="20" as="geometry"/></mxCell><mxCell id="n21" value="solid arrow = what is passed on (labelled) · dashed arrow = optional, fallback or not built yet" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="n11"><mxGeometry x="14" y="180" width="440" height="36" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-6" name="A System: web app, API, graph"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2140" pageHeight="1120" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;TRACE: how the parts fit together (a question goes in, an evidence report with fact-check labels comes out)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;User&lt;/b&gt;&lt;br&gt;asks a research question in the browser and watches the stages live" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="150" width="130" height="100" as="geometry"/></mxCell><mxCell id="n3" value="Web app: Next.js (apps/web)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#e6f2ff;strokeColor=#3d7ab5;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="210" y="70" width="360" height="560" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Pages&lt;/b&gt;&lt;br&gt;Home: question composer&lt;br&gt;/research/[id]: one run&lt;br&gt;History · Report · Settings" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6f2ff;strokeColor=#3d7ab5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="40" width="330" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Research page views&lt;/b&gt;&lt;br&gt;Pipeline (live stages and steps)&lt;br&gt;Timeline · Evidence · Papers&lt;br&gt;Loop 2 panel · Fact-check panel&lt;br&gt;Activity log" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6f2ff;strokeColor=#3d7ab5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="142" width="330" height="100" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Pure logic with tests (lib/*.ts)&lt;/b&gt;&lt;br&gt;factcheck.ts, loop2.ts, trace-types.ts: turn events and the report into what the screens show; events are merged by lane, step and sub-question" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6f2ff;strokeColor=#3d7ab5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="264" width="330" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;lib/api.ts&lt;/b&gt;&lt;br&gt;REST calls and the server-sent-events reader" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e6f2ff;strokeColor=#3d7ab5;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="366" width="330" height="50" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Demo mode (lib/demo-*.ts)&lt;/b&gt;&lt;br&gt;fixtures that replay a run without a backend" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="438" width="330" height="50" as="geometry"/></mxCell><mxCell id="n9" value="API: FastAPI (apps/api/main.py)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="630" y="70" width="440" height="790" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Routers&lt;/b&gt;&lt;br&gt;POST /api/research  (202, starts a run)&lt;br&gt;GET  /api/research  (latest runs)&lt;br&gt;GET  /api/research/{id}  (status)&lt;br&gt;GET  /api/research/{id}/events  (SSE)&lt;br&gt;GET  /api/research/{id}/report&lt;br&gt;GET  /api/research/{id}/papers[/{paper}]" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="40" width="410" height="130" as="geometry"/></mxCell><mxCell id="n11" value="&lt;b&gt;RunManager (services/run_manager.py)&lt;/b&gt;&lt;br&gt;queue of runs, MAX_CONCURRENT_RUNS=1&lt;br&gt;one worker thread per running run &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P16]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;event log per run: run_queued, run_started, stage_started, branch_started, step, branch_completed, stage_completed, run_completed, run_failed&lt;br&gt;each event has seq and timestamp" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="192" width="410" height="130" as="geometry"/></mxCell><mxCell id="n12" value="&lt;b&gt;progress.py&lt;/b&gt;&lt;br&gt;nodes call progress.report(lane, step, state, message, data); the manager turns it into step events with data.lane / step / subQuestionIndex / occurredAt" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="344" width="410" height="80" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;report_service.py&lt;/b&gt;&lt;br&gt;builds the evidence report from the database: sub-questions, sources, findings, quotes, coverage, Loop 2, fact-check labels (supported / partially_supported / unverified / contradicted), token use by purpose" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="446" width="410" height="100" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;db_service.py&lt;/b&gt;&lt;br&gt;all reads and writes to Supabase, with retries on connection errors (503 for the client)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="568" width="410" height="70" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;Logs&lt;/b&gt;&lt;br&gt;logs/pipeline.log + one file per stage; scripts/pipeline_run_report.py turns a run into a Markdown report" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n9"><mxGeometry x="15" y="660" width="410" height="70" as="geometry"/></mxCell><mxCell id="n16" value="Research graph: LangGraph (graph/build_graph.py)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1190" y="70" width="440" height="1000" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;planner  (Stage 1)&lt;/b&gt;&lt;br&gt;question → sub-questions, queries, domain anchor; plan cache" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n16"><mxGeometry x="15" y="40" width="410" height="50" as="geometry"/></mxCell><mxCell id="n18" value="Stage 2: retrieval  &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; two nodes at the same time" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="n16"><mxGeometry x="15" y="170" width="410" height="140" as="geometry"/></mxCell><mxCell id="n19" value="&lt;b&gt;paper_retrieval&lt;/b&gt;&lt;br&gt;papers: search, filter, parse" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n18"><mxGeometry x="12" y="40" width="185" height="70" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;web_search&lt;/b&gt;&lt;br&gt;web pages: search, de-duplicate" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n18"><mxGeometry x="213" y="40" width="185" height="70" as="geometry"/></mxCell><mxCell id="n21" value="&lt;b&gt;summarizer  (Stage 3)&lt;/b&gt;&lt;br&gt;waits for BOTH retrieval nodes &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P2]&lt;/b&gt;&lt;/font&gt;&lt;br&gt;digests, evidence judge, coverage, Loop 2; hands every finished sub-question to Stage 4 while it goes on &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n16"><mxGeometry x="15" y="420" width="410" height="80" as="geometry"/></mxCell><mxCell id="n22" value="&lt;b&gt;factcheck  (Stage 4)&lt;/b&gt;&lt;br&gt;claims, clusters, support, near match, conflicts, labels&lt;br&gt;waits for the early Stage 4 jobs, then writes the results" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n16"><mxGeometry x="15" y="650" width="410" height="70" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;Run complete&lt;/b&gt;&lt;br&gt;run_completed event; the report is built from the database on request" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n16"><mxGeometry x="15" y="800" width="410" height="70" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;Stage 5 (written report)&lt;/b&gt;&lt;br&gt;not built yet; it will read the Stage 4 labels (docs/STAGE4_OUTPUT.md)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;dashed=1;" vertex="1" parent="n16"><mxGeometry x="15" y="900" width="410" height="70" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n17" target="n18" parent="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n18" target="n21" parent="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n21" target="n22" parent="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n22" target="n23" parent="n16"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;Search and access APIs&lt;/b&gt;&lt;br&gt;papers: OpenAlex, Scopus, arXiv, IEEE, Semantic Scholar; PDF routes: Unpaywall, OpenAlex content, repositories, publisher pages&lt;br&gt;web: Tavily, Exa, Parallel (key pools with rotation)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="250" width="380" height="100" as="geometry"/></mxCell><mxCell id="n30" value="&lt;b&gt;Model host (Tailscale, other machine)&lt;/b&gt;&lt;br&gt;TRACE_LLM_URL: fine-tuned planner (LoRA) and the evidence judge judge-v2 (relevance, Stage 3 coverage)&lt;br&gt;DOCLING_URL: PDF to Markdown parser" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="70" width="380" height="80" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;Groq (7 free keys, one pool)&lt;/b&gt;&lt;br&gt;openai/gpt-oss-120b: digests, aspect split, domain anchor, Stage 4 judges (merge, support, near, conflict)&lt;br&gt;token meter per call, purpose and key; daily limit per key" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="450" width="380" height="80" as="geometry"/></mxCell><mxCell id="n32" value="&lt;b&gt;Local models (this machine, CPU)&lt;/b&gt;&lt;br&gt;bge-base-en-v1.5 embedder (shared, access serialised)&lt;br&gt;DeBERTa-v3-large NLI (preloaded in a thread)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="640" width="380" height="70" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Supabase (Postgres)&lt;/b&gt;&lt;br&gt;research_queries, sub_questions, retrieved_papers, web_sources, parsed_papers, pdf_failures, digests, coverage_results, fact_claims, contradictions" style="shape=cylinder3;boundedLbl=1;size=8;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="920" width="380" height="80" as="geometry"/></mxCell><mxCell id="n34" value="&lt;b&gt;Disk caches (save tokens and time)&lt;/b&gt;&lt;br&gt;digest cache (content scope), judge cache, aspect cache, chunk embeddings, plan cache, .cache/stage4_judge, .cache/nli" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1710" y="780" width="380" height="70" as="geometry"/></mxCell><mxCell id="n35" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n36" value="REST + SSE events" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;defaultLabelBackgroundColor=page;" edge="1" source="n7" target="n9" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="runs the graph" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#b85450;defaultLabelBackgroundColor=page;" edge="1" source="n11" target="n16" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n38" value="planner model" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n17" target="n30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n39" value="search, PDFs" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n18" target="n29" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n40" value="judge, Docling" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n18" target="n30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="digests" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n21" target="n31" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n42" value="evidence judge" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n21" target="n30" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="caches" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n21" target="n34" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n44" value="Stage 4 judges" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n22" target="n31" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="NLI + embedder" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n22" target="n32" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="all stages write to it" style="edgeStyle=none;rounded=0;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;dashed=1;" edge="1" source="n23" target="n33" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-7" name="B Parallelism map"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="2160" pageHeight="1900" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;The pipeline, stage by stage, with every place where work runs at the same time marked &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; to &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P16]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="2000" height="30" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Research question&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="50" width="340" height="34" as="geometry"/></mxCell><mxCell id="n3" value="Stage 1: planner (node planner)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#dae8fc;strokeColor=#6c8ebf;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="1000" height="160" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Planner (fine-tuned LoRA, model host)&lt;/b&gt;&lt;br&gt;question → sub-questions with detail questions and search queries" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="15" y="40" width="225" height="80" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Domain anchor (Groq, cached)&lt;/b&gt;&lt;br&gt;1-3 words naming the field, added to every query and to the judge's context" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="255" y="40" width="205" height="80" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;Plan cache&lt;/b&gt;&lt;br&gt;a repeated question reuses the stored plan so searches stay comparable" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="475" y="40" width="200" height="80" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P6]&lt;/b&gt;&lt;/font&gt; NLI preload&lt;/b&gt;&lt;br&gt;thread; DeBERTa loads during Stage 2 and 3" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="690" y="40" width="130" height="80" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;Writes the task plan&lt;/b&gt;&lt;br&gt;Supabase; tells Stage 4 this run may start early" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n3"><mxGeometry x="835" y="40" width="150" height="80" as="geometry"/></mxCell><mxCell id="n9" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n4" target="n5" parent="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n5" target="n6" parent="n3"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n11" value="Stage 2: retrieval (two nodes, &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; at the same time)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="320" width="1000" height="565" as="geometry"/></mxCell><mxCell id="n12" value="paper_retrieval node" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="n11"><mxGeometry x="15" y="40" width="640" height="510" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt; Search every sub-question at once (asyncio)&lt;/b&gt;&lt;br&gt;arXiv · Semantic Scholar (probe first, skipped on HTTP 429) · IEEE · OpenAlex (rerank + semantic) · Scopus; key pools with rotation, per-source rate limiters" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n12"><mxGeometry x="15" y="40" width="610" height="70" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;Embedding pre-filter (bge-base-en-v1.5)&lt;/b&gt;&lt;br&gt;similarity floor 0.56; top 20 per sub-question go on (run 32: 368 candidates → 80 shortlisted)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n12"><mxGeometry x="15" y="132" width="610" height="50" as="geometry"/></mxCell><mxCell id="n15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n13" target="n14" parent="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P4]&lt;/b&gt;&lt;/font&gt; Relevance judge on the model host (judge-v2)&lt;/b&gt;&lt;br&gt;sub-questions filtered at the same time: RELEVANCE_WORKERS=2, each with JUDGE_WORKERS=8 requests; embedder access serialised; rejected papers get a reason" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n12"><mxGeometry x="15" y="204" width="610" height="70" as="geometry"/></mxCell><mxCell id="n17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n14" target="n16" parent="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n18" value="&lt;b&gt;Reliability score + store&lt;/b&gt;&lt;br&gt;combined score; kept papers saved in Supabase (retrieved_papers)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n12"><mxGeometry x="15" y="296" width="610" height="50" as="geometry"/></mxCell><mxCell id="n19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n16" target="n18" parent="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n20" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P5]&lt;/b&gt;&lt;/font&gt; Download and parse the top papers&lt;/b&gt;&lt;br&gt;PDF routes in order: direct, Unpaywall, OpenAlex content, repositories, arXiv twin, HTML full text, headless browser&lt;br&gt;Docling on the host turns the PDF into Markdown; parse cache (parsed_papers); failure memory (pdf_failures)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n12"><mxGeometry x="15" y="368" width="610" height="100" as="geometry"/></mxCell><mxCell id="n21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n18" target="n20" parent="n12"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n22" value="web_search node" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#d5e8d4;strokeColor=#82b366;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="n11"><mxGeometry x="670" y="40" width="315" height="510" as="geometry"/></mxCell><mxCell id="n23" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt; Search the web&lt;/b&gt;&lt;br&gt;Tavily · Exa · Parallel; about 3 query variants per sub-question, all run at the same time; key rotation on a rate limit" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n22"><mxGeometry x="15" y="40" width="285" height="80" as="geometry"/></mxCell><mxCell id="n24" value="&lt;b&gt;De-duplicate and store&lt;/b&gt;&lt;br&gt;about 10-15 unique sources per sub-question (web_sources)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n22"><mxGeometry x="15" y="142" width="285" height="70" as="geometry"/></mxCell><mxCell id="n25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n23" target="n24" parent="n22"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P2]&lt;/b&gt;&lt;/font&gt; Join: the summarizer starts when BOTH nodes are done&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f8cecc;strokeColor=#b85450;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="250" y="910" width="540" height="34" as="geometry"/></mxCell><mxCell id="n27" value="Stage 3: summarizer (node summarizer)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#ffe6cc;strokeColor=#d79b00;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="965" width="1000" height="490" as="geometry"/></mxCell><mxCell id="n28" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P7]&lt;/b&gt;&lt;/font&gt; Preparation per sub-question&lt;/b&gt;&lt;br&gt;split each detail question into aspects (Groq, cached) · cut the source text into 300-word chunks · keep the 5 best chunks per source (bge, chunk-embedding cache)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n27"><mxGeometry x="20" y="40" width="960" height="70" as="geometry"/></mxCell><mxCell id="n29" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P8]&lt;/b&gt;&lt;/font&gt; Digests: one Groq call per source&lt;/b&gt;&lt;br&gt;gpt-oss-120b on a pool of 7 workers (one per key); each finding is a claim + quote, and the quote is checked against the text; digest cache (content-based)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n27"><mxGeometry x="20" y="132" width="960" height="50" as="geometry"/></mxCell><mxCell id="n30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n28" target="n29" parent="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n31" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P9]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P10]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P11]&lt;/b&gt;&lt;/font&gt; Judge + coverage per sub-question&lt;/b&gt;&lt;br&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P9]&lt;/b&gt;&lt;/font&gt; judged as soon as ITS digests are done · &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P10]&lt;/b&gt;&lt;/font&gt; two sub-questions at once · &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P11]&lt;/b&gt;&lt;/font&gt; two judge batches at once to the host (judge-v2, cached verdicts)&lt;br&gt;an aspect is covered by 2 yes from 2 sources; several partial findings can be combined (synthesis)" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n27"><mxGeometry x="20" y="204" width="960" height="70" as="geometry"/></mxCell><mxCell id="n32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n29" target="n31" parent="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n33" value="&lt;b&gt;Loop 2 for aspects left uncovered (searches in parallel)&lt;/b&gt;&lt;br&gt;reselect passages of parsed papers → next papers of the pool → new queries; re-judge after each step; aspects with no evidence at all are recorded as known gaps, not searched" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n27"><mxGeometry x="20" y="296" width="960" height="70" as="geometry"/></mxCell><mxCell id="n34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n31" target="n33" parent="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n35" value="&lt;b&gt;Store digests and coverage, then queue Stage 4 &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt;&lt;/b&gt;&lt;br&gt;written per sub-question; the progress steps are held until the digest step has completed, then replayed in order" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffe6cc;strokeColor=#d79b00;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n27"><mxGeometry x="20" y="388" width="960" height="50" as="geometry"/></mxCell><mxCell id="n36" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n33" target="n35" parent="n27"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n37" value="Stage 4: fact check (node factcheck)" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#e1d5e7;strokeColor=#9673a6;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="40" y="1500" width="1000" height="285" as="geometry"/></mxCell><mxCell id="n38" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt; &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P13]&lt;/b&gt;&lt;/font&gt; Background workers, one job per sub-question&lt;/b&gt;&lt;br&gt;STAGE4_SQ_WORKERS=1 (2 is a switch); the job starts when Stage 3 stored the sub-question; judge counts are kept per job" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n37"><mxGeometry x="20" y="40" width="960" height="50" as="geometry"/></mxCell><mxCell id="n39" value="&lt;b&gt;Per sub-question: claims → clusters → support → near &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt; conflicts → label&lt;/b&gt;&lt;br&gt;near-match judge (Groq) runs beside the conflict check (NLI on CPU) &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt;; judge calls on STAGE4_WORKERS=4 threads &lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P15]&lt;/b&gt;&lt;/font&gt;; answers cached on disk" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n37"><mxGeometry x="20" y="112" width="960" height="50" as="geometry"/></mxCell><mxCell id="n40" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n38" target="n39" parent="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n41" value="&lt;b&gt;factcheck node: wait, collect, write&lt;/b&gt;&lt;br&gt;writes fact_claims and contradictions; a failed sub-question never fails the run" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n37"><mxGeometry x="20" y="184" width="960" height="50" as="geometry"/></mxCell><mxCell id="n42" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n39" target="n41" parent="n37"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n43" value="&lt;b&gt;Run complete: report built from the database&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#f5f5f5;strokeColor=#666666;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="330" y="1810" width="340" height="34" as="geometry"/></mxCell><mxCell id="n44" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n2" target="n3" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n45" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n12" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n46" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n3" target="n22" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n47" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n12" target="n26" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n48" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n22" target="n26" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n49" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n26" target="n27" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n50" value="queued early [P12]" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#C00000;defaultLabelBackgroundColor=page;dashed=1;exitX=0.08;exitY=1;entryX=0.08;entryY=0;" edge="1" source="n35" target="n38" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n51" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n27" target="n37" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n52" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;fontSize=10;strokeColor=#555555;defaultLabelBackgroundColor=page;" edge="1" source="n37" target="n43" parent="1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="n53" value="Parallelism map: what runs at the same time, and the setting that controls it" style="swimlane;startSize=26;html=1;rounded=1;arcSize=2;fontStyle=1;fontSize=13;fillColor=#f8cecc;strokeColor=#b85450;swimlaneFillColor=#ffffff;align=left;spacingLeft=8;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="1100" y="110" width="1020" height="1290" as="geometry"/></mxCell><mxCell id="n54" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P1]&lt;/b&gt;&lt;/font&gt; Graph fan-out&lt;/b&gt;&lt;br&gt;paper_retrieval and web_search start together after the planner (LangGraph)." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="40" width="990" height="50" as="geometry"/></mxCell><mxCell id="n55" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P2]&lt;/b&gt;&lt;/font&gt; Graph join&lt;/b&gt;&lt;br&gt;the summarizer starts only when both retrieval nodes are done." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="104" width="990" height="50" as="geometry"/></mxCell><mxCell id="n56" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P3]&lt;/b&gt;&lt;/font&gt; Searches at the same time&lt;/b&gt;&lt;br&gt;paper node: all sub-questions, each across arXiv, Semantic Scholar, IEEE, OpenAlex, Scopus (asyncio). Web node: the query variants of every sub-question." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="168" width="990" height="50" as="geometry"/></mxCell><mxCell id="n57" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P4]&lt;/b&gt;&lt;/font&gt; Relevance filter across sub-questions&lt;/b&gt;&lt;br&gt;RELEVANCE_WORKERS=2, each with JUDGE_WORKERS=8 host requests (16 at once); the shared embedder is serialised." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="232" width="990" height="50" as="geometry"/></mxCell><mxCell id="n58" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P5]&lt;/b&gt;&lt;/font&gt; Download + parse&lt;/b&gt;&lt;br&gt;PDFs of the top papers are fetched and parsed by Docling as concurrent async tasks (bounded; polite per-host intervals)." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="296" width="990" height="50" as="geometry"/></mxCell><mxCell id="n59" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P6]&lt;/b&gt;&lt;/font&gt; NLI preload&lt;/b&gt;&lt;br&gt;the NLI model loads in a thread during the planner so Stage 4 does not wait for it." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="360" width="990" height="50" as="geometry"/></mxCell><mxCell id="n60" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P7]&lt;/b&gt;&lt;/font&gt; Stage 3 preparation&lt;/b&gt;&lt;br&gt;STAGE3_PREP_WORKERS=4: aspect split, chunking and chunk selection of several sub-questions side by side." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="424" width="990" height="50" as="geometry"/></mxCell><mxCell id="n61" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P8]&lt;/b&gt;&lt;/font&gt; Digest pool&lt;/b&gt;&lt;br&gt;one Groq call per source on a pool of 7 workers (one per key); digest cache reuses digests of a repeated question." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="488" width="990" height="50" as="geometry"/></mxCell><mxCell id="n62" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P9]&lt;/b&gt;&lt;/font&gt; Stage 3 pipeline&lt;/b&gt;&lt;br&gt;STAGE3_PIPELINE=true: a sub-question is judged as soon as ITS digests are done while the digests of the others go on." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="552" width="990" height="50" as="geometry"/></mxCell><mxCell id="n63" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P10]&lt;/b&gt;&lt;/font&gt; Sub-questions judged together&lt;/b&gt;&lt;br&gt;STAGE3_SQ_WORKERS=2: judge, coverage and Loop 2 of two sub-questions at once; Loop 2 searches run in parallel." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="616" width="990" height="50" as="geometry"/></mxCell><mxCell id="n64" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P11]&lt;/b&gt;&lt;/font&gt; Judge batches&lt;/b&gt;&lt;br&gt;JUDGE_PARALLEL=2: two batches at once to the model host; the judge cache is merge-safe under a lock." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="680" width="990" height="50" as="geometry"/></mxCell><mxCell id="n65" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P12]&lt;/b&gt;&lt;/font&gt; Stage 4 overlaps Stage 3&lt;/b&gt;&lt;br&gt;STAGE4_OVERLAP=true: a sub-question goes to Stage 4 the moment Stage 3 stored it; progress events are held until the factcheck stage starts, then replayed with occurredAt." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="744" width="990" height="70" as="geometry"/></mxCell><mxCell id="n66" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P13]&lt;/b&gt;&lt;/font&gt; Stage 4 workers&lt;/b&gt;&lt;br&gt;STAGE4_SQ_WORKERS=1 by default (the queue was the slowest part of run 32); 2 checks two sub-questions at once." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="828" width="990" height="50" as="geometry"/></mxCell><mxCell id="n67" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P14]&lt;/b&gt;&lt;/font&gt; Near match beside conflicts&lt;/b&gt;&lt;br&gt;STAGE4_PARALLEL_STEPS=true: the near-match judge (Groq) runs while the conflict NLI (CPU) computes." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="892" width="990" height="50" as="geometry"/></mxCell><mxCell id="n68" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P15]&lt;/b&gt;&lt;/font&gt; Judge threads&lt;/b&gt;&lt;br&gt;STAGE4_WORKERS=4 judge calls at the same time inside one sub-question; answers cached on disk." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="956" width="990" height="50" as="geometry"/></mxCell><mxCell id="n69" value="&lt;b&gt;&lt;font color=&quot;#C00000&quot;&gt;&lt;b&gt;[P16]&lt;/b&gt;&lt;/font&gt; Runs and screens&lt;/b&gt;&lt;br&gt;API runs in a background thread (MAX_CONCURRENT_RUNS=1, others queue) while the browser reads the event stream." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#ffffff;strokeColor=#999999;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="1020" width="990" height="50" as="geometry"/></mxCell><mxCell id="n70" value="&lt;b&gt;Why some things stay one at a time&lt;/b&gt;&lt;br&gt;the NLI model and the embedder use all CPU cores, so two users of them take turns (locks) instead of speeding up;&lt;br&gt;Groq has a per-minute token limit per key and a daily limit: more parallel calls mean more waiting, never wrong answers (a judge call that fails counts as 'no');&lt;br&gt;every setting above is an environment variable in .env (.env.example); setting it back to 1 or false gives the old order." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="n53"><mxGeometry x="15" y="1094" width="990" height="100" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="trace-8" name="C Timeline of runs 30 and 32"><mxGraphModel adaptiveColors="auto" dx="1400" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1900" pageHeight="700" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="n1" value="&lt;b&gt;Where the time went: run 30 (before the parallel work, 23m 33s) against run 32 (after, 13m 54s), same question, drawn to the same scale&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=16;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="1800" height="30" as="geometry"/></mxCell><mxCell id="n2" value="&lt;b&gt;Run 30 (8 Nov, sequential)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="70" width="210" height="20" as="geometry"/></mxCell><mxCell id="n3" value="&lt;b&gt;search, filter, parse&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="100" width="208" height="34" as="geometry"/></mxCell><mxCell id="n4" value="&lt;b&gt;Stage 3 (digests, judge, Loop 2): 6m 51s&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="468" y="100" width="472" height="34" as="geometry"/></mxCell><mxCell id="n5" value="&lt;b&gt;Stage 4 after Stage 3: 13m 41s&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="940" y="100" width="944" height="34" as="geometry"/></mxCell><mxCell id="n6" value="&lt;b&gt;ends at 1413 s&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1764" y="138" width="200" height="16" as="geometry"/></mxCell><mxCell id="n7" value="&lt;b&gt;Run 32 (10 Nov, overlapped)&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=12;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="200" width="210" height="20" as="geometry"/></mxCell><mxCell id="n8" value="&lt;b&gt;planner, search, filter, parse, prep: 130 s&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="260" y="230" width="149" height="34" as="geometry"/></mxCell><mxCell id="n9" value="&lt;b&gt;Stage 3: 5m 24s&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="409" y="230" width="372" height="34" as="geometry"/></mxCell><mxCell id="n10" value="&lt;b&gt;Loop 2 of sub-question 1: 288 s (the last thing Stage 3 waited for)&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#ffe6cc;strokeColor=#d79b00;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="456" y="280" width="325" height="34" as="geometry"/></mxCell><mxCell id="n11" value="Loop 2 on one aspect" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="285" width="210" height="30" as="geometry"/></mxCell><mxCell id="n12" value="Stage 4 worker (one job at a time)" style="text;html=1;whiteSpace=wrap;fontSize=11;align=left;verticalAlign=top;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="40" y="330" width="210" height="30" as="geometry"/></mxCell><mxCell id="n13" value="&lt;b&gt;Stage 4: sub-question 2 (queued 166 s)&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="450" y="330" width="202" height="34" as="geometry"/></mxCell><mxCell id="n14" value="&lt;b&gt;sub-question 3&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="653" y="330" width="209" height="34" as="geometry"/></mxCell><mxCell id="n15" value="&lt;b&gt;sub-question 4&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="862" y="330" width="148" height="34" as="geometry"/></mxCell><mxCell id="n16" value="&lt;b&gt;sub-question 1&lt;/b&gt;" style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=10;fillColor=#e1d5e7;strokeColor=#9673a6;align=center;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="1010" y="330" width="206" height="34" as="geometry"/></mxCell><mxCell id="n17" value="&lt;b&gt;ends at 833 s&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="1137" y="368" width="200" height="16" as="geometry"/></mxCell><mxCell id="n18" value="" style="endArrow=none;dashed=1;html=1;strokeColor=#C00000;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="782" y="215" as="sourcePoint"/><mxPoint x="782" y="390" as="targetPoint"/></mxGeometry></mxCell><mxCell id="n19" value="Stage 3 ended at 454 s; about 6 minutes of Stage 4 were still queued behind it" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#C00000;" vertex="1" parent="1"><mxGeometry x="788" y="392" width="360" height="32" as="geometry"/></mxCell><mxCell id="n20" value="0 s" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="246" y="440" width="90" height="16" as="geometry"/></mxCell><mxCell id="n21" value="300 s" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="591" y="440" width="90" height="16" as="geometry"/></mxCell><mxCell id="n22" value="600 s" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="936" y="440" width="90" height="16" as="geometry"/></mxCell><mxCell id="n23" value="900 s" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1281" y="440" width="90" height="16" as="geometry"/></mxCell><mxCell id="n24" value="1200 s" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="1626" y="440" width="90" height="16" as="geometry"/></mxCell><mxCell id="n25" value="(0 s = start of the run)" style="text;html=1;whiteSpace=wrap;fontSize=10;align=left;verticalAlign=top;fontColor=#666666;" vertex="1" parent="1"><mxGeometry x="260" y="456" width="900" height="16" as="geometry"/></mxCell><mxCell id="n26" value="&lt;b&gt;What the comparison shows&lt;/b&gt;&lt;br&gt;Stage 4 no longer waits for the whole of Stage 3: 4m 48s of its work ran during Stage 3.&lt;br&gt;But Stage 4 handled the sub-questions one at a time (2 to 3 minutes each), so it became the critical path: the last one started at 653 s. STAGE4_SQ_WORKERS=2 is built to shorten that tail (an estimate of about 3 minutes, not yet measured).&lt;br&gt;Stage 3 itself was also shorter in run 32, but part of that is caches: the stored plan, the parsed papers and the cached judge verdicts. The digest cache did not help in this run." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="40" y="500" width="820" height="110" as="geometry"/></mxCell><mxCell id="n27" value="&lt;b&gt;Groq use and rate limits&lt;/b&gt;&lt;br&gt;run 30: 284,736 tokens, 112 parking events, 8,746 key-seconds parked, the breaker opened in Stage 4.&lt;br&gt;run 32: 290,782 tokens, 159 parking events, 2,769 key-seconds parked, longest pause 37 s, no breaker.&lt;br&gt;Stage 4 is 54% of the tokens: near match 60k, same-claim 59k, support 22k, conflict 15k." style="rounded=1;arcSize=7;whiteSpace=wrap;html=1;fontSize=11;fillColor=#fff2cc;strokeColor=#d6b656;align=left;verticalAlign=middle;spacingLeft=6;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="500" width="820" height="80" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>