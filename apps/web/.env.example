# Public URL of the TRACE FastAPI service, as the BROWSER reaches it. It is inlined into the JavaScript bundle at build time,
# so it must be a URL and never a secret. Every NEXT_PUBLIC_ variable ships to every visitor.
#
#  - development: defaults to http://localhost:8000 when unset
#  - production:  there is no default. If unset, the app calls its own origin, so a reverse proxy must route /api and /health to the API.
#                 Set it to the API's public https URL if the API is on another origin, and list this site in the API's CORS_ORIGINS.
NEXT_PUBLIC_TRACE_API_URL=http://localhost:8000

# Set to "false" to remove demo mode (the browser-side simulator with fictional data), for example in production.
# NEXT_PUBLIC_TRACE_ENABLE_DEMO=false
